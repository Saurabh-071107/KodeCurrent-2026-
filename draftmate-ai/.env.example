# LLM Provider Configuration
# Choose one: "gemini", "openai", "anthropic", "openrouter", "custom"
LLM_PROVIDER=gemini

# Base URL for the LLM API (optional for some providers)
# Gemini: https://generativelanguage.googleapis.com/v1beta
# OpenAI: https://api.openai.com/v1
# Anthropic: https://api.anthropic.com/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# API Key for the LLM provider (REQUIRED)
LLM_API_KEY=Your_gemini_api_key_here

# Model ID to use
# Gemini: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
LLM_MODEL=gemini-3.8-flash

# Optional: Secondary provider configuration (for fallback or different tasks)
# LLM_PROVIDER_SECONDARY=openai
# LLM_BASE_URL_SECONDARY=
# LLM_API_KEY_SECONDARY=
# LLM_MODEL_SECONDARY=

# Request timeout in seconds (default: 30)
LLM_TIMEOUT=30

# Maximum retries for failed requests (default: 3)
LLM_MAX_RETRIES=3

# Embedding Configuration (separate from LLM)
# Provider: "local" (sentence-transformers), "openai", "gemini", "openrouter"
EMBEDDING_PROVIDER=local

# Embedding model to use
# Local: all-MiniLM-L6-v2, all-mpnet-base-v2, etc.
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional: Embedding API base URL (for OpenAI-compatible APIs)
EMBEDDING_BASE_URL=

# Optional: Embedding API key (if using remote provider)
EMBEDDING_API_KEY=

# Document Processing Configuration
# Directory for uploaded files (default: ./uploads)
DOCUMENT_UPLOAD_DIR=./uploads

# Maximum file size in MB (default: 50)
DOCUMENT_MAX_FILE_SIZE_MB=50

# Allowed file extensions (default: .pdf,.docx,.txt)
DOCUMENT_ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# Chunk size in characters (default: 500)
DOCUMENT_CHUNK_SIZE=500

# Chunk overlap in characters (default: 100)
DOCUMENT_CHUNK_OVERLAP=100

# Maximum retrieval results (default: 10)
DOCUMENT_RETRIEVAL_LIMIT=10

# Style Adaptation Configuration
# Directory for style reference documents (default: ./styles)
STYLE_UPLOAD_DIR=./styles

# Maximum style reference file size in MB (default: 50)
STYLE_MAX_FILE_SIZE_MB=50

# Allowed style reference file extensions (default: .pdf,.docx)
STYLE_ALLOWED_EXTENSIONS=.pdf,.docx

# Document Export Configuration
# Output directory for exported documents (default: ./exports)
EXPORT_OUTPUT_DIR=./exports

# Maximum file age in hours before cleanup (default: 24)
EXPORT_MAX_FILE_AGE_HOURS=24

# LibreOffice path for PDF conversion (optional, auto-detected if not set)
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
# Linux/macOS: /usr/bin/libreoffice or /Applications/LibreOffice.app/Contents/MacOS/soffice
LIBREOFFICE_PATH=

# Voice Agent Configuration
# Speech-to-text provider: "openai", "google", "azure", "elevenlabs", "local"
VOICE_STT_PROVIDER=openai

# STT model (OpenAI: whisper-1, Google: latest_short, Azure: whisper)
VOICE_STT_MODEL=whisper-1

# STT API key (if using remote provider)
VOICE_STT_API_KEY=

# STT base URL (for OpenAI-compatible APIs)
VOICE_STT_BASE_URL=

# Text-to-speech provider: "openai", "google", "azure", "elevenlabs", "local"
VOICE_TTS_PROVIDER=openai

# TTS model (OpenAI: tts-1, tts-1-hd; Google: neural2; Azure: neural)
VOICE_TTS_MODEL=tts-1

# TTS voice (OpenAI: alloy, echo, fable, onyx, nova, shimmer)
VOICE_TTS_VOICE=alloy

# TTS API key (if using remote provider)
VOICE_TTS_API_KEY=

# TTS base URL (for OpenAI-compatible APIs)
VOICE_TTS_BASE_URL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO