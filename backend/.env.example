# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/draftmate

# Authentication & JWT
JWT_SECRET=draftmate_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# SMS Local Gateway Configuration
# Documentation: https://app.smslocal.in/
SMS_API_KEY=YOUR_SMSLOCAL_API_KEY
SMS_SENDER_ID=ALERTS
SMS_ROUTE=2
SMS_TEMPLATE_ID=YOUR_DLT_TEMPLATE_ID
SMS_MESSAGE_TEMPLATE="Your OTP for DraftMate verification is {#var#}. Valid for 5 minutes. Do not share with anyone."

# File Storage & Limits
UPLOAD_DIR=./uploads
