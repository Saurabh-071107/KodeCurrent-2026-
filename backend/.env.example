# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/draftmate

# Authentication & JWT Secrets (Replace with high-entropy random secrets)
JWT_SECRET=replace_with_a_strong_high_entropy_secret_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_a_separate_refresh_secret_min_32_chars
JWT_EXPIRES_IN=15m

# Internal AI Service (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace_with_internal_service_secret
AI_REQUEST_TIMEOUT_MS=30000

# SMS Local Gateway Configuration
SMS_API_KEY=YOUR_SMSLOCAL_API_KEY
SMS_SENDER_ID=ALERTS
SMS_ROUTE=2
SMS_TEMPLATE_ID=YOUR_DLT_TEMPLATE_ID
SMS_MESSAGE_TEMPLATE="Your OTP for DraftMate verification is {#var#}. Valid for 5 minutes. Do not share with anyone."

# File Storage & Limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25
