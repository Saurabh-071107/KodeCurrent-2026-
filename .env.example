# ==========================================
# DraftMate AI Environment Configuration
# ==========================================

# Environment: development | testing | production
ENVIRONMENT=development

# Model Provider Settings: openai | anthropic | gemini | ollama | mock
MODEL_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Identifiers
PRIMARY_MODEL=gpt-4o
REASONING_MODEL=o3-mini
FAST_MODEL=gpt-4o-mini

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64

# OCR Configuration
OCR_ENABLED=true
OCR_ENGINE=tesseract
# Set full path if tesseract is not in system PATH, e.g., C:\Program Files\Tesseract-OCR\tesseract.exe or /usr/bin/tesseract
TESSERACT_CMD_PATH=
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_CONFIDENCE_THRESHOLD=60.0

# Storage Paths & Limits
STORAGE_DIR=./data/storage
CACHE_DIR=./data/cache
LOG_DIR=./data/logs
MAX_FILE_SIZE_MB=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/draftmate.log

# Retrieval and Chunking Defaults
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=100
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.70

# Contract Review & Citation Verification Defaults
REVIEW_POSTURE=NEUTRAL
CITATION_VERIFICATION_STRICT_MODE=true
ENABLE_EXTERNAL_LEGAL_SOURCES=false
INDIA_CODE_API_ENDPOINT=https://www.indiacode.nic.in/api/v1
SUPREME_COURT_ESCR_BASE_URL=https://digiscr.sci.gov.in


